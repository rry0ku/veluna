# Maintainer: rry0ku <https://github.com/rry0ku>
pkgname=veluna
pkgver=0.1.6
pkgrel=1
pkgdesc="Ad-free desktop music streaming powered by YouTube Music and Spotify"
arch=('x86_64')
url="https://github.com/rry0ku/veluna"
license=('MIT')
depends=('alsa-lib' 'dbus' 'sqlite' 'libxkbcommon' 'wayland')
makedepends=('cargo' 'pkg-config')
source=("${pkgname}-v${pkgver}.tar.gz::https://github.com/rry0ku/${pkgname}/archive/refs/tags/v${pkgver}.tar.gz"
        "veluna.desktop")
sha256sums=('SKIP'
            'SKIP')

build() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    cargo build --release -p veluna
}

package() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    # Install compiled binary
    install -Dm755 "target/release/veluna" "${pkgdir}/usr/bin/veluna"

    # Install desktop entry
    install -Dm644 "${srcdir}/veluna.desktop" "${pkgdir}/usr/share/applications/veluna.desktop"

    # Install application icon
    if [ -f "assets/linux/veluna.svg" ]; then
        install -Dm644 "assets/linux/veluna.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/veluna.svg"
    fi

    # Install license
    if [ -f "LICENSE" ]; then
        install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    fi
}
